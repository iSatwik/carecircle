# Copy to .env for local use (never commit .env). On Cloud Run set these with --set-env-vars.

# Required in production: long random string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string

# Storage: "memory" for local demo, "firestore" on Google Cloud
STORE=memory
DEFAULT_TIMEZONE=Asia/Kolkata
PUBLIC_URL=http://localhost:8080

# Google Gemini (https://aistudio.google.com/apikey) – optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech (natural voices). Automatic on Cloud Run; locally set TTS_API_KEY
TTS_ENABLED=
TTS_API_KEY=
TTS_VOICE=Aoede

# Email via Gmail SMTP (use a Google App Password) – optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareCircle <your-address@gmail.com>

# Reminders: Cloud Scheduler calls POST /api/cron/tick with header X-Cron-Secret
CRON_SECRET=change-me-too
ENABLE_INTERNAL_SCHEDULER=true
